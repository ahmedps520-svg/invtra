# ─────────────────────────────────────────────────────────────────────────────
# INVTRA configuration. Copy to `.env` and fill in. Every value marked REQUIRED
# must be set in production. Secrets are read on the server only and are never
# sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────────
# REQUIRED. PostgreSQL 14+ connection string.
DATABASE_URL="postgresql://invtra:invtra@localhost:5432/invtra?schema=public"
# REQUIRED. Public origin of the app (used in invitation links and QR codes).
APP_URL="https://invtra.store"
# REQUIRED. ≥ 32 random characters. Signs media URLs. Generate: openssl rand -base64 48
APP_SECRET=""

# ── WhatsApp Business Platform (Cloud API) ──────────────────────────────────
# "mock" (development: nothing is sent; use /dev/whatsapp) or "cloud" (production).
WHATSAPP_PROVIDER="mock"
# REQUIRED for cloud. Permanent System User access token with whatsapp_business_messaging
# and whatsapp_business_management permissions (Meta Business Settings → System users).
WHATSAPP_ACCESS_TOKEN=""
# REQUIRED for cloud. The sending phone number's id (WhatsApp Manager → Phone numbers).
WHATSAPP_PHONE_NUMBER_ID=""
# REQUIRED for cloud. WhatsApp Business Account id (for template sync / submission).
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# REQUIRED (cloud and mock). App Secret of your Meta app — verifies X-Hub-Signature-256 on webhooks.
WHATSAPP_APP_SECRET="dev-mock-app-secret"
# REQUIRED for cloud. Any random string; enter the same value as the webhook "Verify token" in Meta.
WHATSAPP_VERIFY_TOKEN=""
# Optional. Meta App id — only needed to submit templates with IMAGE headers from /admin/templates.
WHATSAPP_APP_ID=""
# Optional. Graph API version.
WHATSAPP_API_VERSION="v23.0"
# Optional. Max messages per second per worker process (Cloud API default throughput is 80/s per number).
WHATSAPP_MAX_MPS="20"

# ── Object storage ──────────────────────────────────────────────────────────
# "local" (files under LOCAL_STORAGE_DIR, served via signed /api/media URLs) or "s3".
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# REQUIRED for s3. Any S3-compatible store: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO.
# Keep the bucket PRIVATE — INVTRA serves files through short-lived presigned URLs.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Email (password resets) ─────────────────────────────────────────────────
# "console" prints emails to the server log; "smtp" sends them.
EMAIL_PROVIDER="console"
SMTP_URL=""               # e.g. smtps://user:pass@smtp.postmarkapp.com:465
EMAIL_FROM="INVTRA <contact@invtra.store>"

# ── Payments ────────────────────────────────────────────────────────────────
# "mock" (development checkout), "manual" (bank transfer; staff mark orders paid in /admin/payments)
# or "stripe" (Stripe Checkout).
PAYMENT_PROVIDER="mock"   # mock | manual | tap (Saudi Arabia: Apple Pay, Google Pay, mada, cards) | stripe
PAYMENT_CURRENCY="SAR"    # SAR (Saudi riyal) | USD | AED | KWD | QAR | BHD | OMR
STRIPE_SECRET_KEY=""      # REQUIRED for stripe
STRIPE_WEBHOOK_SECRET=""  # REQUIRED for stripe — endpoint: {APP_URL}/api/webhooks/payments/stripe
PAYMENT_MANUAL_INSTRUCTIONS=""  # shown to customers when PAYMENT_PROVIDER=manual
TAP_SECRET_KEY=""         # REQUIRED for tap — sk_live_… from the Tap dashboard (webhooks are signed with it)
TAP_MERCHANT_ID=""        # optional — only if Tap asks you to send your merchant id

# ── Business details (shown in the footer and on the Terms page) ───────────────
LEGAL_ENTITY_NAME=""      # e.g. the establishment/company name on your Commercial Registration
LEGAL_CR_NUMBER=""        # Commercial Registration (السجل التجاري) number
LEGAL_VAT_NUMBER=""       # VAT registration number, if registered
LEGAL_ADDRESS=""          # e.g. "Riyadh, Kingdom of Saudi Arabia"
# "Chat with us on WhatsApp" button on the website: support number, digits with country code.
# Defaults to 966557663974; set to "" to hide the button.
SUPPORT_WHATSAPP="966557663974"

# ── Background jobs ─────────────────────────────────────────────────────────
# true: run the queue worker inside the web server (development / single instance).
# In production prefer INLINE_WORKER=false and run `npm run worker` as a separate process.
INLINE_WORKER="true"
WORKER_CONCURRENCY="8"

# ── Bootstrap ───────────────────────────────────────────────────────────────
# `npm run db:seed` creates this admin account if it doesn't exist.
ADMIN_EMAIL="contact@invtra.store"
ADMIN_PASSWORD=""

# ── Tests ───────────────────────────────────────────────────────────────────
# Separate database for `npm test` (migrate it with: DATABASE_URL=$TEST_DATABASE_URL npx prisma migrate deploy).
TEST_DATABASE_URL="postgresql://invtra:invtra@localhost:5432/invtra_test?schema=public"

# ── Search engines (optional) ──────────────────────────────────────────────────
# Ownership tags from Google Search Console / Bing Webmaster Tools ("HTML tag" method — paste only the content="…" value).
# Alternatively verify the whole domain with a DNS TXT record at your registrar and leave these empty.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
# Comma-separated official profile URLs (Instagram, TikTok, X, LinkedIn…) — added to the Organization structured data.
SOCIAL_PROFILES=""
