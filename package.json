{
  "name": "invtra",
  "version": "1.0.0",
  "private": true,
  "description": "INVTRA — premium digital QR invitations delivered through WhatsApp.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "fonts:fetch": "python3 scripts/fetch-fonts.py",
    "start:prod": "prisma migrate deploy && tsx prisma/seed.ts && next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@prisma/client": "^6.19.3",
    "@resvg/resvg-js": "^2.6.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.43.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "node-forge": "^1.4.0",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.7.0",
    "passkit-generator": "^3.6.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "country-flag-icons": "^1.6.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  }
}
